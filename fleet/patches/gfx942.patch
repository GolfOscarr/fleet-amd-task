diff --git a/include/mirage/persistent_kernel/tasks/mi300/linear_ck_mi300.cuh b/include/mirage/persistent_kernel/tasks/mi300/linear_ck_mi300.cuh
index 509463e..6f2a06e 100644
--- a/include/mirage/persistent_kernel/tasks/mi300/linear_ck_mi300.cuh
+++ b/include/mirage/persistent_kernel/tasks/mi300/linear_ck_mi300.cuh
@@ -73,11 +73,21 @@ struct BlockGemmSmallM16Policy
         // Use 16x16x32 MFMA with transposed C distribution (MI350 2x K)
         // MWarp=1 allows MPerBlock=16 (minimal padding for batch=8)
         // NWarp=4 to maintain parallelism across 4 warps (128 threads)
+        // gfx942 (MI300X) has no 16x16x32 BF16 MFMA; use the 16x16x16 warp GEMM
+        // with the same M/N warp grid so every small-tile linear keeps its layout.
+#if defined(__gfx950__)
         return ck_tile::make_tuple(
             ck_tile::WarpGemmMfmaBf16Bf16F32M16N16K32TransposedCDistribution{},
             1,  // MWarp = 1 -> MPerBlock >= 16
             4   // NWarp = 4 -> NPerBlock >= 64
         );
+#else
+        return ck_tile::make_tuple(
+            ck_tile::WarpGemmMfmaBf16Bf16F32M16N16K16TransposedCDistribution{},
+            1,  // MWarp = 1 -> MPerBlock >= 16
+            4   // NWarp = 4 -> NPerBlock >= 64
+        );
+#endif
     }
 };
 
@@ -328,7 +338,11 @@ __device__ __forceinline__ void linear_kernel_ck(void const *input_ptr,
     // MIterPerWarp/NIterPerWarp are computed automatically by BlockUniversalGemmAsBsCr.
     constexpr index_t WarpM = (use_xlarge_tile || use_medium_tile) ? 32 : 16;
     constexpr index_t WarpN = (use_xlarge_tile || use_medium_tile) ? 32 : 16;
+#if defined(__gfx950__)
     constexpr index_t WarpK = (use_xlarge_tile || use_medium_tile) ? 16 : 32;  // MI350: K=32 for small tile
+#else
+    constexpr index_t WarpK = 16;  // gfx942: 16x16x16 is the only BF16 MFMA K for the small tile
+#endif
     using WarpTile = sequence<WarpM, WarpN, WarpK>;
 
     using GemmShape = TileGemmShape<BlockTile, BlockWarps, WarpTile>;
