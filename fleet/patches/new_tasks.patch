+namespace {
+// The ops of a customized graph: the first num_inputs are inputs.
+void split_io(threadblock::Graph const &bgraph, int num_inputs,
+              std::vector<tb::TBInputOp *> &input_ops,
+              std::vector<tb::TBInputOp *> &output_ops) {
+  for (auto const &op : bgraph.operators) {
+    assert(op->op_type == mirage::type::TB_INPUT_OP);
+    if (input_ops.size() < (size_t)num_inputs) {
+      input_ops.push_back(static_cast<tb::TBInputOp *>(op));
+    } else {
+      output_ops.push_back(static_cast<tb::TBInputOp *>(op));
+    }
+  }
+}
+
+std::string float_literal(int bits) {
+  float f;
+  static_assert(sizeof(float) == sizeof(int), "");
+  std::memcpy(&f, &bits, sizeof(f));
+  char buf[64];
+  std::snprintf(buf, sizeof(buf), "%.9ef", (double)f);
+  return std::string(buf);
+}
+
+// Rows the runtime adds to a pointer when the tensor's dim 0 is partitioned
+// by bid.x over the grid (runtime.cc: block_size = dim / grid_dim.x).
+int xcd_offset_dim0(tb::TBInputOp const *op, threadblock::Graph const &bgraph) {
+  if (op->input_map.x == 0) {
+    return op->dtensor.dim[0] / (int)bgraph.grid_dim.x;
+  }
+  return 0;
+}
