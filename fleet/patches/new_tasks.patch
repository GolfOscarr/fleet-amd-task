+// params: [split, n_splits, tiles_per_xcd, nh, d_v, d_c]; inputs partials, W_uv;
+// output attn
+int TaskRegister::register_mla_merge_uv_mi300_task(
+    threadblock::Graph const &bgraph, std::vector<int> const &params) {
+  assert(params.size() == 6);
+  int split = params[0], n_splits = params[1], tiles_per_xcd = params[2];
+  assert(n_splits <= 64 && "mla_merge_uv merges one split per lane of one wavefront");
+  int nh = params[3], d_v = params[4], d_c = params[5];
+  std::vector<tb::TBInputOp *> input_ops, output_ops;
+  int num_inputs = 2, num_outputs = 1;
+  assert(bgraph.operators.size() == (size_t)num_inputs + num_outputs);
+  split_io(bgraph, num_inputs, input_ops, output_ops);
+  assert(input_ops[0]->dtensor.dim[0] == n_splits && input_ops[0]->dtensor.dim[1] == nh &&
+         input_ops[0]->dtensor.dim[2] == ((d_c + 1 + 3) / 4) * 4);
+  assert(input_ops[1]->dtensor.dim[0] == nh && input_ops[1]->dtensor.dim[1] == d_v &&
+         input_ops[1]->dtensor.dim[2] == d_c);
+  assert(output_ops[0]->dtensor.dim[1] == nh * d_v);
+  assert(bgraph.grid_dim.x == 8 && nh % 8 == 0);
+  int heads_per_xcd = nh / 8;
+  assert(tiles_per_xcd == heads_per_xcd);
+  int offset_rows = xcd_offset_dim0(input_ops[0], bgraph);
+  int w_uv_local = (input_ops[1]->input_map.x == 0) ? 1 : 0;
+  int out_local = (output_ops[0]->input_map.x == 1) ? 1 : 0;
+  mirage::transpiler::CodeKeeper code;
+  code.inc_indent();
+  code.e("kernel::mla_merge_uv_mi300_task_impl<bfloat16, $, $, $>(", nh, d_v, d_c);
+  code.e("    task_desc->input_ptrs[0],");   // partials
+  code.e("    task_desc->input_ptrs[1],");   // W_uv (this XCD's heads when partitioned)
+  code.e("    task_desc->output_ptrs[0],");  // attn (this XCD's columns when partitioned)
+  code.e("    runtime_config.step[0],");
+  code.e("    $,", split);
+  code.e("    $,", n_splits);
+  code.e("    $,", tiles_per_xcd);
+  code.e("    $,", heads_per_xcd);
+  code.e("    $,", offset_rows);
+  code.e("    $,", w_uv_local);
+  code.e("    $,", out_local);
+  code.e("    tile_idx);");
+  return register_task_variant(TASK_MLA_MERGE_UV_MI300, code.to_string());
+}
