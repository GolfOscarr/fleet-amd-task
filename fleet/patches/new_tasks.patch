+// params: [topk, n_experts, n_forced, scaling_bits, layer_index, hidden];
+// inputs h, W_gate; outputs topk_w, routing, mask, logits, route_log
+int TaskRegister::register_moe_router_mi300_task(
+    threadblock::Graph const &bgraph, std::vector<int> const &params) {
+  assert(params.size() == 6);
+  int topk = params[0], n_experts = params[1], n_forced = params[2];
+  int layer_index = params[4], hidden = params[5];
+  std::vector<tb::TBInputOp *> input_ops, output_ops;
+  int num_inputs = 2, num_outputs = 5;
+  assert(bgraph.operators.size() == (size_t)num_inputs + num_outputs);
+  split_io(bgraph, num_inputs, input_ops, output_ops);
+  assert(input_ops[0]->dtensor.dim[1] == hidden);
+  assert(input_ops[1]->dtensor.dim[0] == n_experts && input_ops[1]->dtensor.dim[1] == hidden);
+  assert(output_ops[0]->dtensor.dim[1] == topk + n_forced);
+  assert(output_ops[1]->dtensor.dim[0] == n_experts + n_forced);
+  assert(output_ops[2]->dtensor.dim[0] == n_experts + n_forced + 1);
+  assert(output_ops[3]->dtensor.dim[1] == n_experts);
+  assert(output_ops[4]->dtensor.num_dims == 3 && output_ops[4]->dtensor.dim[2] == topk + n_forced);
+  int route_steps = output_ops[4]->dtensor.dim[0];
+  int route_layers = output_ops[4]->dtensor.dim[1];
+  mirage::transpiler::CodeKeeper code;
+  code.inc_indent();
+  code.e("kernel::moe_router_mi300_task_impl<bfloat16, $, $, $, $, $, $>(",
+         hidden, n_experts, n_forced, topk, route_steps, route_layers);
+  code.e("    task_desc->input_ptrs[0],");   // h
+  code.e("    task_desc->input_ptrs[1],");   // W_gate
+  code.e("    task_desc->output_ptrs[0],");  // topk_w
+  code.e("    task_desc->output_ptrs[1],");  // routing
+  code.e("    task_desc->output_ptrs[2],");  // mask
+  code.e("    task_desc->output_ptrs[3],");  // logits (boundary B8)
+  code.e("    task_desc->output_ptrs[4],");  // route_log
+  code.e("    runtime_config.step[0],");
+  code.e("    runtime_config.prompt_length[0],");   // row = step - (prompt_len - 1)
+  code.e("    $,", layer_index);
+  code.e("    $);", float_literal(params[3]));      // routed_scaling_factor
+  return register_task_variant(TASK_MOE_ROUTER_MI300, code.to_string());
+}
