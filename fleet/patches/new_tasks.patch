+// params: [softmax_scale_bits, split, n_splits, tiles_per_xcd, nh, d_c, d_r];
+// inputs ql_nope, q_pe, c_kv, k_pe; outputs partials [, debug scores]
+int TaskRegister::register_mla_attend_mi300_task(
+    threadblock::Graph const &bgraph, std::vector<int> const &params) {
+  assert(params.size() == 7);
+  int split = params[1], n_splits = params[2], tiles_per_xcd = params[3];
+  int nh = params[4], d_c = params[5], d_r = params[6];
+  std::vector<tb::TBInputOp *> input_ops, output_ops;
+  int num_inputs = 4;
+  int num_outputs = (int)bgraph.operators.size() - num_inputs;
+  assert(num_outputs == 1 || num_outputs == 2);
+  split_io(bgraph, num_inputs, input_ops, output_ops);
+  assert(input_ops[0]->dtensor.dim[0] == nh && input_ops[0]->dtensor.dim[1] == d_c);
+  assert(input_ops[1]->dtensor.dim[0] == nh && input_ops[1]->dtensor.dim[1] == d_r);
+  int s_max = input_ops[2]->dtensor.dim[0];
+  assert(input_ops[2]->dtensor.dim[1] == d_c);
+  assert(input_ops[3]->dtensor.dim[0] == s_max && input_ops[3]->dtensor.dim[1] == d_r);
+  assert(output_ops[0]->dtensor.num_dims == 3 && output_ops[0]->dtensor.dim[0] == n_splits &&
+         output_ops[0]->dtensor.dim[1] == nh && output_ops[0]->dtensor.dim[2] == ((d_c + 1 + 3) / 4) * 4);
+  assert((s_max + split - 1) / split == n_splits);
+  assert(bgraph.grid_dim.x == 8);
+  int offset_rows = xcd_offset_dim0(output_ops[0], bgraph);
+  mirage::transpiler::CodeKeeper code;
+  code.inc_indent();
+  code.e("kernel::mla_attend_mi300_task_impl<bfloat16, $, $, $, $>(", nh, d_c, d_r, s_max);
+  code.e("    task_desc->input_ptrs[0],");   // ql_nope
+  code.e("    task_desc->input_ptrs[1],");   // q_pe
+  code.e("    task_desc->input_ptrs[2],");   // c_kv
+  code.e("    task_desc->input_ptrs[3],");   // k_pe
+  code.e("    task_desc->output_ptrs[0],");  // partials
+  code.e("    runtime_config.step[0],");
+  code.e("    $,", float_literal(params[0]));
+  code.e("    $,", split);
+  code.e("    $,", n_splits);
+  code.e("    $,", tiles_per_xcd);
+  code.e("    $,", offset_rows);
+  code.e("    tile_idx,");
+  if (num_outputs == 2) {
+    code.e("    task_desc->output_ptrs[1]);");   // debug scores (MLA_ATTEND_DEBUG_SCORES)
+  } else {
+    code.e("    nullptr);");
+  }
+  return register_task_variant(TASK_MLA_ATTEND_MI300, code.to_string());
+}
