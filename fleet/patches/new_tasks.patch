+// ---------------------------------------------------------------------------
+// DeepSeek-V2-Lite decode tasks (fleet/tasks/mi300; pointer orders and params
+// from fleet/build_graph.py; math from harness/numpy_ref.py)
+
+namespace {
+// The ops of a customized graph: the first num_inputs are inputs.
+void split_io(threadblock::Graph const &bgraph, int num_inputs,
+              std::vector<tb::TBInputOp *> &input_ops,
+              std::vector<tb::TBInputOp *> &output_ops) {
+  for (auto const &op : bgraph.operators) {
+    assert(op->op_type == mirage::type::TB_INPUT_OP);
+    if (input_ops.size() < (size_t)num_inputs) {
+      input_ops.push_back(static_cast<tb::TBInputOp *>(op));
+    } else {
+      output_ops.push_back(static_cast<tb::TBInputOp *>(op));
+    }
+  }
+}
+
+std::string float_literal(int bits) {
+  float f;
+  static_assert(sizeof(float) == sizeof(int), "");
+  std::memcpy(&f, &bits, sizeof(f));
+  char buf[64];
+  std::snprintf(buf, sizeof(buf), "%.9ef", (double)f);
+  return std::string(buf);
+}
+
+// Rows the runtime adds to a pointer when the tensor's dim 0 is partitioned
+// by bid.x over the grid (runtime.cc: block_size = dim / grid_dim.x).
+int xcd_offset_dim0(tb::TBInputOp const *op, threadblock::Graph const &bgraph) {
+  if (op->input_map.x == 0) {
+    return op->dtensor.dim[0] / (int)bgraph.grid_dim.x;
+  }
+  return 0;
+}
+} // namespace
+
+// params: [nh, d_n, d_r, d_c]; inputs qkva, w_kv_norm, W_uk, cos, sin;
+// outputs c_kv, k_pe, ql_nope, q_pe
+int TaskRegister::register_mla_prep_mi300_task(
+    threadblock::Graph const &bgraph, std::vector<int> const &params) {
+  assert(params.size() == 4);
+  int nh = params[0], d_n = params[1], d_r = params[2], d_c = params[3];
+  std::vector<tb::TBInputOp *> input_ops, output_ops;
+  int num_inputs = 5, num_outputs = 4;
+  assert(bgraph.operators.size() == (size_t)num_inputs + num_outputs);
+  split_io(bgraph, num_inputs, input_ops, output_ops);
+  assert(input_ops[0]->dtensor.num_dims == 2);
+  assert(input_ops[0]->dtensor.dim[1] == nh * (d_n + d_r) + d_c + d_r);
+  assert(input_ops[2]->dtensor.num_dims == 3 && input_ops[2]->dtensor.dim[0] == nh &&
+         input_ops[2]->dtensor.dim[1] == d_n && input_ops[2]->dtensor.dim[2] == d_c);
+  assert(output_ops[0]->dtensor.dim[1] == d_c && output_ops[1]->dtensor.dim[1] == d_r);
+  assert(output_ops[2]->dtensor.dim[0] == nh && output_ops[2]->dtensor.dim[1] == d_c);
+  assert(output_ops[3]->dtensor.dim[0] == nh && output_ops[3]->dtensor.dim[1] == d_r);
+  mirage::transpiler::CodeKeeper code;
+  code.inc_indent();
+  code.e("kernel::mla_prep_mi300_task_impl<bfloat16, $, $, $, $>(", nh, d_n, d_r, d_c);
+  code.e("    task_desc->input_ptrs[0],");   // qkva
+  code.e("    task_desc->input_ptrs[1],");   // w_kv_norm
+  code.e("    task_desc->input_ptrs[2],");   // W_uk
+  code.e("    task_desc->input_ptrs[3],");   // cos
+  code.e("    task_desc->input_ptrs[4],");   // sin
+  code.e("    task_desc->output_ptrs[0],");  // c_kv (row step)
+  code.e("    task_desc->output_ptrs[1],");  // k_pe (row step)
+  code.e("    task_desc->output_ptrs[2],");  // ql_nope
+  code.e("    task_desc->output_ptrs[3],");  // q_pe
+  code.e("    runtime_config.step[0],");
+  code.e("    1e-6f);");                     // kv_a_layernorm eps (01-execution-flow.md)
+  return register_task_variant(TASK_MLA_PREP_MI300, code.to_string());
+}
