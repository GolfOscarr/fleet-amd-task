+  assert(input_ops[1]->dtensor.dim[0] == nh && input_ops[1]->dtensor.dim[1] == d_v &&
+         input_ops[1]->dtensor.dim[2] == d_c);
+  assert(output_ops[0]->dtensor.dim[1] == nh * d_v);
