+// outputs h, topk_w, routing, mask, logits, route_log; the kernel's NORM template flag.
+int TaskRegister::register_moe_router_mi300_task(
+    threadblock::Graph const &bgraph, std::vector<int> const &params, bool norm) {
+  assert(params.size() == (norm ? 7u : 6u));
+  int topk = params[0], n_experts = params[1], n_forced = params[2];
+  int layer_index = params[4], hidden = params[5];
+  std::vector<tb::TBInputOp *> input_ops, output_ops;
+  int num_inputs = norm ? 3 : 2, num_outputs = norm ? 6 : 5;
+  assert(bgraph.operators.size() == (size_t)num_inputs + num_outputs);
+  split_io(bgraph, num_inputs, input_ops, output_ops);
+  int in_gate = norm ? 2 : 1;     // W_gate's input slot
+  int out0 = norm ? 1 : 0;        // topk_w's output slot (h takes slot 0 when norm)
+  assert(input_ops[0]->dtensor.dim[1] == hidden);                       // h, or x_res
+  if (norm) {
+    assert(input_ops[1]->dtensor.dim[0] == hidden);                     // w_norm [hidden]
+    assert(output_ops[0]->dtensor.dim[1] == hidden);                    // h [1, hidden]
+  }
+  assert(input_ops[in_gate]->dtensor.dim[0] == n_experts && input_ops[in_gate]->dtensor.dim[1] == hidden);
+  assert(output_ops[out0 + 0]->dtensor.dim[1] == topk + n_forced);
+  assert(output_ops[out0 + 1]->dtensor.dim[0] == n_experts + n_forced);
+  assert(output_ops[out0 + 2]->dtensor.dim[0] == n_experts + n_forced + 1);
+  assert(output_ops[out0 + 3]->dtensor.dim[1] == n_experts);
+  assert(output_ops[out0 + 4]->dtensor.num_dims == 3 && output_ops[out0 + 4]->dtensor.dim[2] == topk + n_forced);
+  int route_steps = output_ops[out0 + 4]->dtensor.dim[0];
+  int route_layers = output_ops[out0 + 4]->dtensor.dim[1];
+  mirage::transpiler::CodeKeeper code;
+  code.inc_indent();
+  code.e("kernel::moe_router_mi300_task_impl<bfloat16, $, $, $, $, $, $, $>(",
+         hidden, n_experts, n_forced, topk, route_steps, route_layers, norm ? "true" : "false");
+  code.e("    task_desc->input_ptrs[0],");                                   // h, or x_res
+  code.e("    $,", norm ? "task_desc->input_ptrs[1]" : "nullptr");          // w_norm
+  code.e("    task_desc->input_ptrs[$],", in_gate);                          // W_gate
+  code.e("    $,", norm ? "task_desc->output_ptrs[0]" : "nullptr");         // h out
+  code.e("    task_desc->output_ptrs[$],", out0 + 0);  // topk_w
+  code.e("    task_desc->output_ptrs[$],", out0 + 1);  // routing
+  code.e("    task_desc->output_ptrs[$],", out0 + 2);  // mask
+  code.e("    task_desc->output_ptrs[$],", out0 + 3);  // logits (boundary B8)
+  code.e("    task_desc->output_ptrs[$],", out0 + 4);  // route_log
+  code.e("    runtime_config.step[0],");
+  code.e("    runtime_config.prompt_length[0],");   // row = step - (prompt_len - 1)
+  code.e("    $,", layer_index);
+  code.e("    $,", float_literal(params[3]));       // routed_scaling_factor
+  code.e("    $);", norm ? float_literal(params[6]) : std::string("0.0f"));   // eps
+  return register_task_variant(TASK_MOE_ROUTER_MI300, code.to_string());
+}
